# ─── Historify environment variables ────────────────────────────────────────
#
# LOCAL DEVELOPMENT (vite dev / vite preview)
# Copy this file to `.env.local` (which is git-ignored) and paste your key.
# When VITE_ANTHROPIC_API_KEY is set, the browser talks to Anthropic directly
# and attaches it as the `x-api-key` header.
#
#   cp .env.example .env.local
#   # then edit .env.local and set the key below
#
VITE_ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PRODUCTION (Netlify)
# Do NOT ship a key to the browser in production. Instead set ANTHROPIC_API_KEY
# in the Netlify dashboard (Site settings → Environment variables). The edge
# function at netlify/edge-functions/chat.ts reads it server-side and injects
# the x-api-key header, so the client posts to /api/chat with no key exposed.
#
# ANTHROPIC_API_KEY is configured in Netlify, NOT here.
