// Historify backend — Prisma schema (PostgreSQL)
// Mirrors the client's localStorage models 1:1 so the frontend sync layer can
// hydrate/flush without shape translation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Tier {
  FREE
  BEGINNER // "Beginner Student" — timeline, flashcards, 10 Clio messages/day
  PRO
  MASTER // "Master Student Plan" — gates Chronos Crisis Room + Video Review
}

enum Sender {
  user
  clio
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String
  passwordHash String
  tier         Tier     @default(FREE)
  language     String   @default("en") // en | es | ru | mk
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now()) // presence heartbeat

  // ── Billing (Stripe subscription + free trial) ──
  stripeCustomerId   String?   @unique
  subscriptionId     String?
  subscriptionStatus String? // trialing | active | past_due | canceled
  trialEndsAt        DateTime?
  renewsAt           DateTime?

  chatSessions      ClioChatSession[]
  crisisStates      CrisisRoomState[]
  progress          ProgressSnapshot?
  campaign          CampaignProgress?
  learnerProfile    LearnerProfile?
  weekPlan          WeekPlanRecord?
  studySets         StudySet[]
  bookmarks         Bookmark[]
  notes             NotesSnapshot?
  philosopherMemory PhilosopherMemoryRecord?
  friendsA          Friendship[]             @relation("friendA")
  friendsB          Friendship[]             @relation("friendB")
  sentMessages      DirectMessage[]          @relation("msgFrom")
  recvMessages      DirectMessage[]          @relation("msgTo")
  imperiumCampaigns ImperiumCampaign[]
  appReview         AppReview?
  giftsSent         GiftSubscription[]       @relation("giftsSent")
  giftsReceived     GiftSubscription[]       @relation("giftsReceived")

  // Gift reward: percent off the gifter's next renewal (consumed at billing).
  nextRenewalDiscountPct Int @default(0)
}

// Accepted friendship (undirected pair, stored once with a < b ordering).
model Friendship {
  id        String   @id @default(cuid())
  aId       String
  bId       String
  createdAt DateTime @default(now())
  a         User     @relation("friendA", fields: [aId], references: [id], onDelete: Cascade)
  b         User     @relation("friendB", fields: [bId], references: [id], onDelete: Cascade)

  @@unique([aId, bId])
  @@index([aId])
  @@index([bId])
}

// Durable direct message between two users. Relayed live over sockets when the
// recipient is online, and persisted so it is delivered on next connect.
model DirectMessage {
  id        String    @id @default(cuid())
  fromId    String
  toId      String
  text      String
  createdAt DateTime  @default(now())
  readAt    DateTime?
  from      User      @relation("msgFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User      @relation("msgTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([toId, createdAt])
  @@index([fromId, toId])
}

// A pending History 1v1 challenge from one user to another.
model DuelChallenge {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  status    String   @default("pending") // pending | accepted | declined | expired
  createdAt DateTime @default(now())

  @@index([toId, status])
}

// Whole-progress snapshot mirroring the client progress store (XP, streaks,
// completed lessons/quizzes, achievements). Client-authoritative for now:
// hydrate on login, flush after mutations; last write wins per device.
model ProgressSnapshot {
  userId    String   @id
  data      Json
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Territory Conquest Campaign state (stars, best scores, banked XP per stage).
model CampaignProgress {
  userId    String   @id
  data      Json
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ClioChatSession {
  id        String            @id @default(cuid())
  userId    String
  title     String            @default("")
  language  String            @default("en")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ClioChatMessage[]

  @@index([userId, updatedAt])
}

model ClioChatMessage {
  id        String          @id @default(cuid())
  sessionId String
  sender    Sender
  text      String
  timestamp DateTime        @default(now())
  session   ClioChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestamp])
}

// Clio's persistent learner memory (interests, misconceptions, mastered facts,
// session summaries). Client-authoritative blob, one per user.
model LearnerProfile {
  userId    String   @id
  data      Json
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// The generated weekly study plan (steps + AI coach notes + manual checkoffs).
model WeekPlanRecord {
  userId    String   @id
  data      Json
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Personal lesson notes (client-authoritative blob, one per user).
model NotesSnapshot {
  userId    String   @id
  data      Json
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Per-philosopher debate memory (stances, concessions, win records) — the
// debate twin of LearnerProfile. Client-authoritative blob, one per user.
model PhilosopherMemoryRecord {
  userId    String   @id
  data      Json
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One AI Studio study set (flashcards + questions + facts generated from a
// user-pasted source). Discrete rows so sets sync and delete individually;
// the id is the client-generated UUID.
model StudySet {
  id        String   @id
  userId    String
  name      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// A single lesson the user has bookmarked. One row per (user, lesson); the
// composite primary key makes add/remove idempotent and the set naturally
// de-duplicated. Mirrors the client-side bookmarkStore (a list of lessonIds).
model Bookmark {
  userId    String
  lessonId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@index([userId, createdAt])
}

// A gifted month of a paid plan. Sending one grants the recipient the tier
// for one month and books a 50% discount on the gifter's next renewal
// (User.nextRenewalDiscountPct, consumed by the billing cycle).
model GiftSubscription {
  id          String   @id @default(cuid())
  gifterId    String
  recipientId String
  tier        Tier
  status      String   @default("active") // active | expired
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  gifter      User     @relation("giftsSent", fields: [gifterId], references: [id], onDelete: Cascade)
  recipient   User     @relation("giftsReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, status])
  @@index([gifterId, createdAt])
}

// One public app review per user, shown on the landing page. Upserted so a
// user can revise their review; username is denormalized at write time so the
// public listing never joins into private account data.
model AppReview {
  userId    String   @id
  username  String
  role      String   @default("")
  rating    Int
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

// ─── CHRONOS IMPERIUM (Part D): campaign persistence & turn snapshots ────────
// One row per campaign; the full CampaignSnapshot for every completed turn
// block lives in ImperiumTurnSnapshot so any turn can be restored exactly.
// Rollback is a transactional multi-table operation (see routes/imperium.ts):
// snapshots above the target turn are pruned and the campaign head is moved in
// one $transaction, always touching tables in the same order (campaign →
// snapshots) so concurrent rollbacks/appends cannot deadlock.
model ImperiumCampaign {
  id             String                 @id // client-generated: "imperium-<era>-<seed36>"
  userId         String
  era            String
  seed           Int
  playerRosterId String
  rivalRosterId  String
  playerLeaderId String
  rivalLeaderId  String
  currentTurn    Int                    @default(0)
  over           Boolean                @default(false)
  playerWon      Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots      ImperiumTurnSnapshot[]

  @@index([userId, updatedAt])
}

// Full snapshot state per turn block. `state` is the serialized
// CampaignSnapshot (ownership, armies, crises, log…); `checksum` is a FNV-1a
// signature over the canonical JSON so a tampered or truncated snapshot is
// rejected instead of silently restored.
model ImperiumTurnSnapshot {
  id         String           @id @default(cuid())
  campaignId String
  turn       Int
  state      Json
  checksum   String
  createdAt  DateTime         @default(now())
  campaign   ImperiumCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, turn])
  @@index([campaignId, turn])
}

model CrisisRoomState {
  id              String   @id @default(cuid())
  userId          String
  crisisId        String // e.g. "crisis-rubicon"
  activeStep      Int      @default(0)
  concluded       Boolean  @default(false)
  // [{ step, optionId, text, revealedConsequence? }]
  decisionHistory Json     @default("[]")
  // { diplomaticCapital, domesticStability, militaryReadiness, treasury } 0–100
  resourceMetrics Json     @default("{\"diplomaticCapital\":50,\"domesticStability\":50,\"militaryReadiness\":50,\"treasury\":50}")
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, crisisId])
}
