# Historify backend — environment template. Copy to .env and fill in.

# PostgreSQL connection string (Neon/Supabase/RDS all work)
DATABASE_URL="postgresql://user:password@localhost:5432/historify?schema=public"

# HMAC secret for JWT signing — generate with: openssl rand -base64 48
JWT_SECRET=""

# Comma-separated allowlist of frontend origins (never use * with credentials)
CORS_ORIGIN="http://localhost:5173,https://your-site.netlify.app"

# Server-side Anthropic key for the /api/chat proxy path (no VITE_ prefix —
# this one must never reach a client bundle)
ANTHROPIC_API_KEY=""

PORT=4000
NODE_ENV=production

# ── Stripe billing (paid launch: subscriptions with free trial) ──────────────
# Secret key from https://dashboard.stripe.com/apikeys (sk_live_... / sk_test_...)
STRIPE_SECRET_KEY=""
# Webhook signing secret from https://dashboard.stripe.com/webhooks (whsec_...)
# Point the webhook at POST https://<your-api>/api/billing/webhook with events:
#   checkout.session.completed, customer.subscription.created,
#   customer.subscription.updated, customer.subscription.deleted,
#   invoice.payment_failed
STRIPE_WEBHOOK_SECRET=""
# Recurring price IDs (Products → Pricing in the Stripe dashboard)
STRIPE_PRICE_PRO=""      # $10/mo Pro Learner
STRIPE_PRICE_MASTER=""   # $20/mo Master Student
# Free-trial length in days for every paid plan (launch plan: 3–5; clamped 0–14)
TRIAL_DAYS=5
# Public site origin used for checkout redirect URLs
FRONTEND_URL="http://localhost:5173"
