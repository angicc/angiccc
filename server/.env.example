# Historify backend — environment template. Copy to .env and fill in.

# PostgreSQL connection string (Neon/Supabase/RDS all work)
DATABASE_URL="postgresql://user:password@localhost:5432/historify?schema=public"

# HMAC secret for JWT signing — generate with: openssl rand -base64 48
JWT_SECRET=""

# Comma-separated allowlist of frontend origins (never use * with credentials)
CORS_ORIGIN="http://localhost:5173,https://your-site.netlify.app"

# Server-side Anthropic key for the /api/chat proxy path (no VITE_ prefix —
# this one must never reach a client bundle)
ANTHROPIC_API_KEY=""

PORT=4000
NODE_ENV=production
